<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
    Name="SentinelGrid Agent"
    Manufacturer="SentinelGrid"
    Version="0.1.4"
    UpgradeCode="B632A689-8C9E-4E77-BF7C-5E9C4A012901"
    Scope="perMachine">

    <!-- =========================
         UPGRADE
    ========================= -->

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of SentinelGrid Agent is already installed."
    />

    <!-- =========================
         MEDIA
    ========================= -->

    <MediaTemplate
      EmbedCab="yes"
    />

    <!-- =========================
         INSTALL DIRECTORY
    ========================= -->

    <StandardDirectory
      Id="ProgramFiles6432Folder">

      <Directory
        Id="INSTALLFOLDER"
        Name="SentinelGrid">

        <Component
          Id="SentinelGridAgentComponent"
          Guid="*">

          <!-- AGENT -->

          <File
            Id="SentinelGridAgentExe"
            Source="..\..\agent\SentinelGridAgent.exe"
            KeyPath="yes"
          />

          <!-- SERVICE -->

          <ServiceInstall
            Id="SentinelGridAgentServiceInstall"
            Name="SentinelGridAgent"
            DisplayName="SentinelGrid Agent"
            Description="SentinelGrid monitoring and remote management agent."
            Type="ownProcess"
            Start="auto"
            ErrorControl="normal"
            Account="LocalSystem"
          />

          <ServiceControl
            Id="SentinelGridAgentServiceControl"
            Name="SentinelGridAgent"
            Start="install"
            Stop="both"
            Remove="uninstall"
            Wait="yes"
          />

        </Component>

      </Directory>

    </StandardDirectory>

    <!-- =========================
         ENROLLMENT COMMAND

         OriginalDatabase keeps the
         downloaded MSI filename with
         the SG-ENROLL token.
    ========================= -->

    <CustomAction
      Id="EnrollSentinelGridAgent"
      FileRef="SentinelGridAgentExe"
      ExeCommand='-server "https://sentinelgrid-one.vercel.app" -installer "[OriginalDatabase]"'
      Return="asyncNoWait"
      Impersonate="no"
    />

    <!-- =========================
         RUN AFTER INSTALL COMPLETES
    ========================= -->

    <InstallExecuteSequence>

      <Custom
        Action="EnrollSentinelGridAgent"
        After="InstallFinalize"
        Condition="NOT Installed"
      />

    </InstallExecuteSequence>

    <!-- =========================
         FEATURE
    ========================= -->

    <Feature
      Id="MainFeature"
      Title="SentinelGrid Agent"
      Level="1">

      <ComponentRef
        Id="SentinelGridAgentComponent"
      />

    </Feature>

  </Package>

</Wix>