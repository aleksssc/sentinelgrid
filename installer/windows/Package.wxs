<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
    Name="SentinelGrid Agent"
    Manufacturer="SentinelGrid"
    Version="0.1.3"
    UpgradeCode="B632A689-8C9E-4E77-BF7C-5E9C4A012901"
    Scope="perMachine">

    <!-- =========================
         UPGRADE
    ========================= -->

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of SentinelGrid Agent is already installed."
    />

    <!-- =========================
         MEDIA
    ========================= -->

    <MediaTemplate
      EmbedCab="yes"
    />

    <!-- =========================
         INSTALL DIRECTORY
    ========================= -->

    <StandardDirectory
      Id="ProgramFiles6432Folder">

      <Directory
        Id="INSTALLFOLDER"
        Name="SentinelGrid">

        <!-- =========================
             AGENT COMPONENT
        ========================= -->

        <Component
          Id="SentinelGridAgentComponent"
          Guid="*">

          <!-- =========================
               AGENT EXE
          ========================= -->

          <File
            Id="SentinelGridAgentExe"
            Source="..\..\agent\SentinelGridAgent.exe"
            KeyPath="yes"
          />

          <!-- =========================
               WINDOWS SERVICE
          ========================= -->

          <ServiceInstall
            Id="SentinelGridAgentServiceInstall"
            Name="SentinelGridAgent"
            DisplayName="SentinelGrid Agent"
            Description="SentinelGrid monitoring and remote management agent."
            Type="ownProcess"
            Start="auto"
            ErrorControl="normal"
            Account="LocalSystem"
          />

          <ServiceControl
            Id="SentinelGridAgentServiceControl"
            Name="SentinelGridAgent"
            Start="install"
            Stop="both"
            Remove="uninstall"
            Wait="yes"
          />

        </Component>

      </Directory>

    </StandardDirectory>

    <!-- =========================
         PREPARE ENROLLMENT

         OriginalDatabase points to
         the MSI the user launched.

         Filename:

         SentinelGridAgent__
         SG-ENROLL-xxxxx.msi
    ========================= -->

    <SetProperty
      Id="EnrollSentinelGridAgent"
      Value='-server "https://sentinelgrid-one.vercel.app" -installer "[OriginalDatabase]"'
      Before="EnrollSentinelGridAgent"
      Sequence="execute"
    />

    <!-- =========================
         ENROLLMENT ACTION
    ========================= -->

    <CustomAction
      Id="EnrollSentinelGridAgent"
      FileRef="SentinelGridAgentExe"
      ExeCommand="[CustomActionData]"
      Execute="deferred"
      Impersonate="no"
      Return="check"
      HideTarget="yes"
    />

    <!-- =========================
         INSTALL ORDER

         1. Agent EXE installed
         2. Enrollment runs
         3. agent.json created
         4. Service starts
    ========================= -->

    <InstallExecuteSequence>

      <Custom
        Action="EnrollSentinelGridAgent"
        Before="StartServices"
        Condition="NOT Installed"
      />

    </InstallExecuteSequence>

    <!-- =========================
         FEATURE
    ========================= -->

    <Feature
      Id="MainFeature"
      Title="SentinelGrid Agent"
      Level="1">

      <ComponentRef
        Id="SentinelGridAgentComponent"
      />

    </Feature>

  </Package>

</Wix>