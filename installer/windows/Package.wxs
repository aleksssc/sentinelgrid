<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
    Name="SentinelGrid Agent"
    Manufacturer="SentinelGrid"
    Version="0.1.1"
    UpgradeCode="B632A689-8C9E-4E77-BF7C-5E9C4A012901"
    Scope="perMachine">

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of SentinelGrid Agent is already installed."
    />

    <MediaTemplate EmbedCab="yes" />

    <!-- =========================
         PROPERTIES
    ========================= -->

    <Property
      Id="ENROLLMENT_TOKEN"
      Secure="yes"
      Hidden="yes"
    />

    <Property
      Id="SENTINELGRID_SERVER"
      Value="https://sentinelgrid-one.vercel.app"
      Secure="yes"
    />

    <!-- =========================
         FILES + SERVICE
    ========================= -->

    <StandardDirectory Id="ProgramFiles6432Folder">

      <Directory
        Id="INSTALLFOLDER"
        Name="SentinelGrid">

        <Component
          Id="SentinelGridAgentComponent"
          Guid="*">

          <File
            Id="SentinelGridAgentExe"
            Source="..\..\agent\SentinelGridAgent.exe"
            KeyPath="yes"
          />

          <ServiceInstall
            Id="SentinelGridAgentServiceInstall"
            Name="SentinelGridAgent"
            DisplayName="SentinelGrid Agent"
            Description="SentinelGrid monitoring and remote management agent."
            Type="ownProcess"
            Start="auto"
            ErrorControl="normal"
            Account="LocalSystem"
          />

          <ServiceControl
            Id="SentinelGridAgentServiceControl"
            Name="SentinelGridAgent"
            Start="install"
            Stop="both"
            Remove="uninstall"
            Wait="yes"
          />

        </Component>

      </Directory>

    </StandardDirectory>

    <!-- =========================
         ENROLLMENT CUSTOM ACTION
    ========================= -->

    <SetProperty
      Id="EnrollSentinelGridAgent"
      Value='-server "[SENTINELGRID_SERVER]" -token "[ENROLLMENT_TOKEN]"'
      Before="EnrollSentinelGridAgent"
      Sequence="execute"
      Condition="NOT Installed AND ENROLLMENT_TOKEN"
    />

    <CustomAction
      Id="EnrollSentinelGridAgent"
      FileRef="SentinelGridAgentExe"
      ExeCommand="[CustomActionData]"
      Execute="deferred"
      Impersonate="no"
      Return="check"
      HideTarget="yes"
    />

    <InstallExecuteSequence>

      <Custom
        Action="EnrollSentinelGridAgent"
        After="InstallFiles"
        Condition="NOT Installed AND ENROLLMENT_TOKEN"
      />

    </InstallExecuteSequence>

    <!-- =========================
         FEATURE
    ========================= -->

    <Feature
      Id="MainFeature"
      Title="SentinelGrid Agent"
      Level="1">

      <ComponentRef
        Id="SentinelGridAgentComponent"
      />

    </Feature>

  </Package>

</Wix>