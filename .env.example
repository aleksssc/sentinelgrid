# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local/public application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis REST credentials
UPSTASH_REDIS_KV_REST_API_URL=https://your-database.upstash.io
UPSTASH_REDIS_KV_REST_API_TOKEN=your-upstash-rest-token

# Optional remote data-plane services
SENTINELGRID_RELAY_URL=wss://relay.example.com
SENTINELGRID_REMOTE_GATEWAY_URL=https://gateway.example.com
NEXT_PUBLIC_REMOTE_GATEWAY_URL=https://gateway.example.com
GUACD_URL=guacd:4822

# Agent releases: server-side kill switch. Keep false pending Windows qualification.
SENTINELGRID_AGENT_UPDATES_ENABLED=false

# Build machine only; export to PowerShell (the build script does not load .env files).
# SHA1 thumbprint selects an existing code-signing certificate in Cert:\CurrentUser\My.
SENTINELGRID_SIGN_CERT_THUMBPRINT=YOUR_40_HEX_CERTIFICATE_THUMBPRINT
# Comma-separated SHA256 leaf certificate fingerprints pinned into Agent and updater.
SENTINELGRID_UPDATE_SIGNER_SHA256=YOUR_64_HEX_SIGNER_CERTIFICATE_SHA256
SENTINELGRID_SIGN_TIMESTAMP_URL=https://timestamp.example.com
