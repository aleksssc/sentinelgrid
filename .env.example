# Supabase (use an isolated test project for qualification)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Existing realtime and RDP one-time tickets
UPSTASH_REDIS_KV_REST_API_URL=https://your-database.upstash.io
UPSTASH_REDIS_KV_REST_API_TOKEN=your-upstash-rest-token

# Application ONLY. Unset preserves the current Vercel/local WebSocket routes.
# Activate only after qualifying the separately hosted relay; see relay\README.md.
# SENTINELGRID_REALTIME_URL=wss://realtime.example.com
# Standalone service ONLY (same Supabase and Redis credentials as the application):
# SENTINELGRID_REALTIME_BROWSER_ORIGIN=https://app.example.com
# SENTINELGRID_REALTIME_BIND=127.0.0.1
# SENTINELGRID_REALTIME_PORT=8444
# PORT is also accepted, but SENTINELGRID_REALTIME_PORT takes precedence.
# SENTINELGRID_REALTIME_MAX_CONNECTIONS=2000
# SENTINELGRID_REALTIME_SHUTDOWN_GRACE_MS=30000
# Private container/service behind a TLS proxy ONLY: opt in and bind 0.0.0.0.
# The proxy MUST replace X-Forwarded-Proto with https; block direct public access.
# Never enable on a plaintext public port. Without opt-in or TLS, only loopback binds.
# SENTINELGRID_REALTIME_TRUST_PROXY=true
# Optional direct TLS (both files required, readable by the relay process):
# SENTINELGRID_REALTIME_TLS_CERT=C:\secure\realtime-public-chain.pem
# SENTINELGRID_REALTIME_TLS_KEY=C:\secure\realtime-private-key.pem
# Node 22+ loads .env.local then .env in development only, without writing either.
# Process variables win; unlike Next.js, Node does not expand $VARIABLE references.
# NODE_ENV=production disables implicit env files. Inject secrets at runtime.
# Optional explicit env file (read-only, also accepted in production/test):
# SENTINELGRID_REALTIME_ENV_FILE=C:\secure\realtime.env
# Local browser origin may be http://localhost:3000 ONLY outside production/test.
# Endpoint discovery still requires WSS, including for a locally trusted TLS relay.

# Native RDP relay. Leave URL/secret unset until the isolated relay is configured.
# App and relay share one random 32-byte hex secret; NEVER expose it via NEXT_PUBLIC_*.
# SENTINELGRID_RELAY_URL=wss://relay.example.com/rdp
# SENTINELGRID_RDP_RELAY_SECRET=YOUR_RANDOM_64_HEX_RELAY_SECRET
# Relay process only: HTTPS origin of the matching test Next.js application.
# SENTINELGRID_RDP_BACKEND_URL=https://test-app.example.com
# SENTINELGRID_RELAY_BIND=127.0.0.1
# SENTINELGRID_RELAY_PORT=8443
# PORT is also accepted and is used when SENTINELGRID_RELAY_PORT is omitted.
# Railway/container TLS termination ONLY: opt in before binding a cleartext listener publicly.
# The proxy MUST replace X-Forwarded-Proto with the exact value https and direct
# cleartext access to the relay must be blocked. The public URL remains wss://.../rdp.
# SENTINELGRID_RDP_TRUST_PROXY=true
# Optional direct TLS (both files required, readable by the relay process):
# SENTINELGRID_RELAY_TLS_CERT=C:\secure\relay-public-chain.pem
# SENTINELGRID_RELAY_TLS_KEY=C:\secure\relay-private-key.pem

# Server-side auto-update switch. Keep false pending installed Windows qualification.
SENTINELGRID_AGENT_UPDATES_ENABLED=false

# Build machine ONLY. Signing settings are read from the PROCESS environment,
# never from .env files. Explicit setup-signing.ps1 persists public identifiers
# to the current process and Windows User environment; private keys stay in Cert:.
# Production: .\scripts\setup-signing.ps1 -Profile Production
SENTINELGRID_SIGN_CERT_THUMBPRINT=YOUR_40_HEX_PRODUCTION_CERTIFICATE_THUMBPRINT
SENTINELGRID_UPDATE_SIGNER_SHA256=YOUR_64_HEX_PRODUCTION_SIGNER_CERTIFICATE_SHA256
SENTINELGRID_SIGN_TIMESTAMP_URL=https://timestamp.example.com
# SENTINELGRID_SIGN_CERT_STORE=CurrentUser
# Setup defaults to https://timestamp.digicert.com only if no timestamp is configured.
# Override with -TimestampUrl https://your-rfc3161-provider.example.com.

# DEVELOPMENT ONLY: .\scripts\setup-signing.ps1 -Profile Beta
# Beta and dev use the existing DEVELOPMENT ONLY certificate, never the PROD signer.
# SENTINELGRID_DEV_SIGN_CERT_STORE=LocalMachine
# SENTINELGRID_DEV_SIGN_CERT_THUMBPRINT=YOUR_40_HEX_DEVELOPMENT_THUMBPRINT
# SENTINELGRID_DEV_UPDATE_SIGNER_SHA256=YOUR_64_HEX_DEVELOPMENT_SIGNER_CERTIFICATE_SHA256
# SENTINELGRID_DEV_SIGN_TIMESTAMP_URL=https://your-rfc3161-provider.example.com

# Daily command: .\scripts\release-agent.ps1 -Channel beta
# Stable requires an explicit version: -Channel stable -Version 1.0.0
# The orchestrator reads these settings from the process or read-only .env.local.
# Explicit backend PUBLISH settings take priority over NEXT_PUBLIC_SUPABASE_URL
# and SUPABASE_SERVICE_ROLE_KEY/SUPABASE_SECRET_KEY.
# Optional -WebsiteURL https://your-website.example.com overrides website discovery;
# an invalid explicit override fails. Otherwise try NEXT_PUBLIC_APP_URL,
# NEXT_PUBLIC_BASE_URL, NEXT_PUBLIC_SITE_URL, APP_URL in order, ignoring ineligible
# values such as http://localhost:3000 (never upgraded to HTTPS). As in release-beta,
# eligible HTTPS URLs are reduced to their origin; credentials/query/fragment reject.
# Then try the Server/ServerURL/server_url value in ProgramData\SentinelGrid\agent.json,
# finally https://sentinelgrid-one.vercel.app. No manual env setup is required.
# SENTINELGRID_PUBLISH_SUPABASE_URL=https://your-project.supabase.co
# SENTINELGRID_PUBLISH_SERVICE_ROLE_KEY=YOUR_BACKEND_ADMIN_KEY
# Optional verification organizations (UUIDs, with real clients and valid owners):
# SENTINELGRID_RELEASE_BETA_ORGANIZATION_ID=YOUR_BETA_ORGANIZATION_UUID
# SENTINELGRID_RELEASE_STABLE_ORGANIZATION_ID=YOUR_STABLE_ORGANIZATION_UUID
# SENTINELGRID_RELEASE_DEV_ORGANIZATION_ID=YOUR_DEV_ORGANIZATION_UUID
# -OrganizationId takes priority. Wrong effective channel aborts without fallback.
# Without a configured UUID, discovery only selects an organization in that channel.
# No settings row means stable, matching the website's effective-channel policy.
# The orchestrator injects/revokes the temporary token and sets development consent
# only for beta/dev. Do not persist the temporary token in an env file.
# Low-level publisher ONLY (the daily orchestrator sets these temporarily):
# SENTINELGRID_PUBLISH_WEBSITE_URL=https://your-website.example.com
# SENTINELGRID_PUBLISH_ENROLLMENT_TOKEN=YOUR_UNUSED_WEBSITE_TOKEN
# SENTINELGRID_PUBLISH_ALLOW_DEVELOPMENT=true

SENTINELGRID_AGENT_UPDATES_ENABLED=true
